    "Reads the signed app transaction from Apple. This does not validate purchases or Premium access.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads the signed app transaction from Apple. This does not validate purchases or Premium access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee la transacción de la app firmada por Apple. No valida compras ni el acceso Premium."
          }
        }
      }
    },
    "Diagnostic build. Your shopping lists and subscription are not accessed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostic build. Your shopping lists and subscription are not accessed."
