            "value": "Gestionar invitaciones"
          }
        }
      }
    },
    "Microphone access is not allowed. You can allow it in Settings or enter products manually.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono no tiene permiso. Puedes permitirlo en Ajustes o escribir los productos a mano."
          }
        }
      }
    },
    "Name: up to 160 characters. Quantity and store: up to 80 characters.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre: hasta 160 caracteres. Cantidad y tienda: hasta 80 caracteres."
          }
        }
      }
    },
    "Name: up to 160 characters. Quantity and store: up to 80. Quantity is optional.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre: hasta 160 caracteres. Cantidad y tienda: hasta 80. La cantidad es opcional."
          }
        }
      }
    },
