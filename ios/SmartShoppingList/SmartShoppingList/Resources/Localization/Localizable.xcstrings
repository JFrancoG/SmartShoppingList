      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido interpretar este texto. Puedes añadir los productos a mano."
          }
        }
      }
    },
    "To correct products or quantities, return to the draft before confirming.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para corregir productos o cantidades, vuelve al borrador antes de confirmar."
          }
        }
      }
    },
    "To recover the submission, sign in with the same Apple Account that started it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para recuperar el envío, accede con la misma cuenta de Apple que lo inició."
          }
        }
      }
    },
    "Too many attempts. Wait a moment before retrying.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay demasiados intentos. Espera un momento antes de reintentar."
          }
        }
      }
    },
    "Transcription is unavailable in the selected language on this device. You can type the text or add products manually.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción en el idioma seleccionado no está disponible en este dispositivo. Puedes escribir el texto o añadir los productos a mano."
          }
        }
      }
    },
    "Transcription is unavailable on this device. You can type the text or add products manually.": {
      "comment": "The transcription service is unavailable on this device; this does not imply an unsupported language.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción no está disponible en este dispositivo. Puedes escribir el texto o añadir los productos a mano."
          }
        }
      }
    },
    "Turn on Apple Intelligence in Settings to interpret text. You can still add products manually.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Apple Intelligence en Ajustes para interpretar texto. La entrada manual sigue disponible."
          }
        }
      }
    },
    "Type or dictate": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe o dicta"
          }
        }
      }
    },
    "Unnamed product": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Producto sin nombre"
          }
        }
      }
    },
    "You can also open an invitation to join another group. Each account belongs to one group only.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También puedes abrir una invitación para unirte a otro grupo. Cada cuenta pertenece a un solo grupo."
          }
        }
      }
    },
    "You can interpret the text and review the products before adding them to the group.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes interpretar el texto y revisar los productos antes de añadirlos al grupo."
          }
        }
      }
    },
    "You have already accepted this invitation.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya has aceptado esta invitación."
          }
        }
      }
    },
    "Your account already belongs to a group. Refresh to check its status.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta ya pertenece a un grupo. Actualiza para consultar su estado."
          }
        }
      }
    },
    "Your draft and pending invitation are kept while you sign in.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu borrador y la invitación pendiente se conservan durante el acceso."
          }
        }
      }
    },
    "Your group": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu grupo"
          }
        }
      }
    },
    "Your saved access could not be restored. Unlock the device and reopen the app; your data is kept without overwriting it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido recuperar el acceso guardado. Desbloquea el dispositivo y vuelve a abrir la app; conservamos los datos sin sobrescribirlos."
          }
        }
      }
    },
    "Your session has expired or been revoked. Sign in again with the same Apple Account.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión ha caducado o se ha revocado. Accede de nuevo con la misma cuenta de Apple."
          }
        }
      }
    },
    "Changed or unavailable products have been deselected. Review the list and select any products you still want to buy.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han desmarcado los productos que cambiaron o ya no están pendientes. Revisa la lista y vuelve a marcar los que quieras comprar."
          }
        }
      }
    },
    "This product is no longer pending in this store. Your changes were not saved.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este producto ya no está pendiente en esta tienda. Tus cambios no se han guardado."
          }
        }
      }
    }
  },
  "version": "1.1"
}
