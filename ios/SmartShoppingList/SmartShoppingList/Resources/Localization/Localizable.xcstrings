    "Enter a product name.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el nombre del producto."
          }
        }
      }
    },
    "Enter a store name.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el nombre de la tienda."
          }
        }
      }
    },
    "Enter a valid group name of up to 80 Unicode characters.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe un nombre de grupo válido de hasta 80 caracteres Unicode."
