{
  "sourceLanguage": "en",
  "strings": {
    "A submission is awaiting confirmation. Its data is kept so you can retry without duplicating it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay un envío pendiente de confirmación. Conservamos sus datos para reintentarlo sin duplicarlo."
          }
        }
      }
    },
    "Accept invitation": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceptar invitación"
          }
        }
      }
    },
    "Accepted": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceptada"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir"
          }
        }
      },
      "comment": "Tab for preparing products in the local shopping draft. Verb."
    },
    "Add at least one product to review the draft.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade al menos un producto para revisar el borrador."
          }
        }
      }
    },
    "Add product manually": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir producto a mano"
          }
        }
      }
    },
    "Adds all reviewed products to the group with the chosen stores.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade todos los productos revisados al grupo con las tiendas elegidas."
          }
        }
      }
    },
    "Another invitation is saved. Resolve or discard it before reviewing the new link.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay otra invitación guardada. Resuelve o descarta la anterior para revisar el nuevo enlace."
          }
        }
      }
    },
    "Apple did not return the required credentials. Start signing in again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple no ha devuelto las credenciales necesarias. Vuelve a iniciar el acceso."
          }
        }
      }
    },
    "Apply": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicar"
          }
        }
      }
    },
    "Back": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        }
      }
    },
    "Cancel dictation": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar dictado"
          }
        }
      }
    },
    "Cancel interpretation": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar interpretación"
          }
        }
      }
    },
    "Cancel pending product?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cancelar producto pendiente?"
          }
        }
      }
    },
    "Changes the local selection. The purchase is saved when you tap Finish shopping.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia la selección local. La compra se guarda al pulsar Finalizar compra."
          }
        }
      }
    },
    "Check availability": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobar disponibilidad"
          }
        }
      }
    },
    "Check this product": {
      "comment": "Title of a shopping notice when the source is the product editor.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa este producto"
          }
        }
      }
    },
    "Choose a store from the group or confirm the name you reviewed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una tienda del grupo o confirma el nombre que has revisado."
          }
        }
      }
    },
    "Choose stores and confirm": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir tiendas y confirmar"
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar"
          }
        }
      }
    },
    "Confirm adding to group": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmar incorporación al grupo"
          }
        }
      }
    },
    "Confirm an option for each name. If that name already exists in the group, the same store will be used.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma una opción para cada nombre. Si ese nombre ya existe en el grupo, se usará la misma tienda."
          }
        }
      }
    },
    "Confirm purchase": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmar compra"
          }
        }
      }
    },
    "Confirm stores": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma las tiendas"
          }
        }
      }
    },
    "Confirm the name “%@”": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmar el nombre «%@»"
          }
        }
      },
      "comment": "Store confirmation action. The placeholder is a user-entered store name."
    },
    "Confirms only the selected products from this store for the whole group.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma únicamente los productos seleccionados de esta tienda para todo el grupo."
          }
        }
      }
    },
    "Could not load this store. Refresh to try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido cargar esta tienda. Actualiza para reintentarlo."
          }
        }
      }
    },
    "Create a group": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crear un grupo"
          }
        }
      }
    },
    "Create group": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crear grupo"
          }
        }
      }
    },
    "Create invitation": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crear invitación"
          }
        }
      }
    },
    "Created invitations": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitaciones creadas"
          }
        }
      }
    },
    "Created on %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Creada el %@"
          }
        }
      },
      "comment": "Invitation creation timestamp, formatted using the current locale."
    },
    "Deselect changed products": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desmarcar los productos que han cambiado"
          }
        }
      },
      "extractionState": "stale"
    },
    "Dictate": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictar"
          }
        }
      }
    },
    "Discard invitation": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartar invitación"
          }
        }
      }
    },
    "Dismiss notice": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar aviso"
          }
        }
      }
    },
    "Draft reviewed. It has not been sent to the group yet.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrador revisado. Todavía no se ha enviado al grupo."
          }
        }
      }
    },
    "Draft storage": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservación del borrador"
          }
        }
      }
    },
    "Each link lets one person join within 24 hours. Share it now: the link cannot be retrieved after reopening the app.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada enlace permite que una persona se una durante 24 horas. Compártelo ahora: el enlace no se recupera al volver a abrir la app."
          }
        }
      }
    },
    "Edit": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Editar"
          }
        }
      },
      "comment": "Button to edit a draft product. Verb."
    },
    "Edit %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Editar %@"
          }
        }
      },
      "comment": "Accessibility label for editing a draft product. The placeholder is its user-entered name."
    },
    "Edit product": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Editar producto"
          }
        }
