# Optional identity configuration. Copy to .env, then replace and uncomment the required Apple values.
# Never commit .env or signing/encryption keys. Leaving all Apple values absent keeps local bootstrap available.
LOG_LEVEL=info
INVITATION_ORIGIN=https://your-real-domain.example

# Native execution: path to the private .p8 outside the repository.
# With docker-compose.identity.yml: use /run/secrets/apple-sign-in.p8 here.
# APPLE_CLIENT_ID=com.plusprojects.SmartShoppingList
# APPLE_TEAM_ID=YOURTEAMID
# APPLE_KEY_ID=YOURKEYID0
# APPLE_PRIVATE_KEY_PATH=/absolute/private/path/AuthKey.p8
# Railway: use a sealed multiline APPLE_PRIVATE_KEY_PEM variable instead of APPLE_PRIVATE_KEY_PATH.
# Configure exactly one key source. Do not copy a real PEM into this example.

# Optional PostgreSQL CA certificate(s), PEM encoded, from the database environment.
# DATABASE_CA_CERTIFICATE_PEM=REPLACE_WITH_MULTILINE_CA_CERTIFICATE
# When set, TLS is required with certificate and hostname verification; empty/invalid values fail startup.

# 32 random bytes, base64 encoded, held outside PostgreSQL; retain old versions during rotation.
# APPLE_REFRESH_ACTIVE_KEY_VERSION=v1
# APPLE_REFRESH_KEYS_JSON={"v1":"REPLACE_WITH_BASE64_OF_32_RANDOM_BYTES"}

# Only used by the optional Docker identity override; absolute host path outside the repository.
# APPLE_PRIVATE_KEY_HOST_PATH=/absolute/private/path/AuthKey.p8
